<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="start|end"
    tools:ignore="HardcodedText, UseSwitchCompatOrMaterialXml, UselessParent, TooManyViews">

    <!-- Outer Horizontal Layout -->
    <LinearLayout
        android:id="@+id/layout_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Hidden Control Icon -->
        <RelativeLayout
            android:id="@+id/layout_icon_control_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imageview_control"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_launcher" />
        </RelativeLayout>

        <!-- Main Floating Panel - Cyberpunk Theme -->
        <LinearLayout
            android:id="@+id/layout_main_view"
            android:layout_width="400dp"
            android:layout_height="350dp"
            android:orientation="horizontal"
            android:visibility="visible"
            android:background="#0A0A12">

            <!-- Left Navigation Panel - Terminal Style -->
            <LinearLayout
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="8dp"
                android:gravity="center_vertical"
                android:background="#111122">

                <!-- ESP Tab - Active State -->
                <LinearLayout
                    android:id="@+id/navf1"
                    android:layout_width="50dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="#2600F0FF">
                    
                    <View
                        android:id="@+id/head1"
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:visibility="visible"
                        android:background="#00F0FF" />

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="30dp"
                        android:text="ESP"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#00F0FF"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Items Tab -->
                <LinearLayout
                    android:id="@+id/navf2"
                    android:layout_width="50dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:visibility="gone"
                    android:background="#222233">

                    <View
                        android:id="@+id/head2"
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:visibility="gone"
                        android:background="#00F0FF" />

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="30dp"
                        android:text="ITEMS"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#808080"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Cars Tab -->
                <LinearLayout
                    android:id="@+id/navf5"
                    android:layout_width="50dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:visibility="gone"
                    android:background="#222233">

                    <View
                        android:id="@+id/head5"
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:visibility="gone"
                        android:background="#00F0FF" />

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="30dp"
                        android:text="CARS"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#808080"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Aim Tab -->
                <LinearLayout
                    android:id="@+id/navf3"
                    android:layout_width="50dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="#222233">

                    <View
                        android:id="@+id/head3"
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:visibility="gone"
                        android:background="#00F0FF" />

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="30dp"
                        android:text="AIM"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#808080"
                        android:gravity="center" />
                </LinearLayout>

                <!-- SDK Tab -->
                <LinearLayout
                    android:id="@+id/navf4"
                    android:layout_width="50dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="#222233">

                    <View
                        android:id="@+id/head4"
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:visibility="gone"
                        android:background="#00F0FF" />

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="30dp"
                        android:text="SDK"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#808080"
                        android:gravity="center" />
                </LinearLayout>



                <!-- Close Button - Your original ID preserved -->
                <ImageView
                    android:id="@+id/layout_close_main_view"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginBottom="8dp"
                    android:tint="#FF5555"
                    android:src="@drawable/baseline_close_24"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Right Side Content - Terminal Display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="#0A0A12">

                <!-- Terminal Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:orientation="horizontal"
                    android:background="#111122"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical"
                        android:background="#0A0A12">

                        <!-- ESP Panel -->
                        <LinearLayout
                            android:id="@+id/menuf1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:background="#0A0A12">
                            <include layout="@layout/esp_visual" />
                        </LinearLayout>

                        <!-- Items Panel -->
                        <LinearLayout
                            android:id="@+id/menuf2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:background="#0A0A12">
                            <include layout="@layout/esp_inventory" />
                        </LinearLayout>

                        <!-- Aim Panel -->
                        <LinearLayout
                            android:id="@+id/menuf3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:background="#0A0A12">
                            <include layout="@layout/esp_aimbot" />
                        </LinearLayout>

                        <!-- SDK Panel -->
                        <LinearLayout
                            android:id="@+id/menuf4"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:background="#0A0A12">
                            <include layout="@layout/esp_memory" />
                        </LinearLayout>

                        <!-- Skin Panel -->
                        <LinearLayout
                            android:id="@+id/menuf5"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:background="#0A0A12">
                            <include layout="@layout/esp_skin" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>