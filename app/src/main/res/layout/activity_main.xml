<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <ScrollView
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">

            <!-- Apple iOS Large Title Header Row -->
            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="22dp">

                <ImageView
                    android:layout_height="48dp"
                    android:layout_width="48dp"
                    android:src="@drawable/ic_launcher"
                    android:background="@drawable/logo_glow_ring"
                    android:padding="2dp"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Featurestic Lite Loader"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Virtual Container • GG &amp; .SO"
                        android:textColor="#8E8E93"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="1dp" />

                </LinearLayout>

                <!-- Hidden Sign Out Button (kept for ID compatibility, hidden from UI) -->
                <TextView
                    android:id="@+id/btnSignOut"
                    android:layout_height="0dp"
                    android:layout_width="0dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- iOS Section Header: SUBSCRIPTION -->
            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="SUBSCRIPTION"
                android:textColor="#8E8E93"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="6dp" />

            <!-- Apple iOS Grouped Inset Card 1: Countdown & Device -->
            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:background="@drawable/white_card_bg"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <!-- 4-Column Apple Metric Row -->
                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:background="@drawable/countdown_box_bg"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginBottom="14dp"
                    android:weightSum="4">

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvD"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="00"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="Days"
                            android:textColor="#8E8E93"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvH"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="00"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="Hours"
                            android:textColor="#8E8E93"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvM"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="00"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="Minutes"
                            android:textColor="#8E8E93"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvS"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="00"
                            android:textColor="#0A84FF"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="Seconds"
                            android:textColor="#8E8E93"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Compact Apple Settings-Style Info Footer -->
                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvDeviceInfo"
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Device"
                        android:textColor="#8E8E93"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/tvLoaderInfo"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="GG &amp; .SO Ready"
                        android:textColor="#30D158"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- iOS Section Header: MODULES -->
            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="MODULES"
                android:textColor="#8E8E93"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="6dp" />

            <!-- Apple iOS Grouped Inset Card 2: GG APK & Custom .SO Rows -->
            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:background="@drawable/neon_module_card_bg"
                android:orientation="vertical"
                android:layout_marginBottom="22dp">

                <!-- Row 1: GameGuardian APK -->
                <LinearLayout
                    android:id="@+id/cardGgModule"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="10dp">

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="GameGuardian"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvGgStatus"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="Tap + to add GG APK from phone"
                            android:textColor="#8E8E93"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <!-- Circular iOS + Button -->
                    <TextView
                        android:id="@+id/btnAddGg"
                        android:layout_height="34dp"
                        android:layout_width="34dp"
                        android:background="@drawable/neon_plus_btn_bg"
                        android:text="+"
                        android:textColor="#0A84FF"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:layout_marginEnd="8dp" />

                    <!-- Apple App Store Pill Action Button -->
                    <TextView
                        android:id="@+id/btnLaunchGg"
                        android:layout_height="32dp"
                        android:layout_width="wrap_content"
                        android:minWidth="68dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:background="@drawable/neon_action_cyan_bg"
                        android:text="OPEN"
                        android:textColor="#0A84FF"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:gravity="center" />

                </LinearLayout>

                <!-- Apple Inset Hairline Separator -->
                <View
                    android:layout_height="0.7dp"
                    android:layout_width="match_parent"
                    android:layout_marginStart="16dp"
                    android:background="#2C2C2E" />

                <!-- Row 2: Custom .SO Library -->
                <LinearLayout
                    android:id="@+id/cardSoModule"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="10dp">

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="Custom Plugin (.so)"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSoStatus"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="Tap + to add .so library from phone"
                            android:textColor="#8E8E93"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <!-- Circular iOS + Button -->
                    <TextView
                        android:id="@+id/btnAddSo"
                        android:layout_height="34dp"
                        android:layout_width="34dp"
                        android:background="@drawable/neon_plus_btn_bg"
                        android:text="+"
                        android:textColor="#0A84FF"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:layout_marginEnd="8dp" />

                    <!-- Apple App Store Pill Action Button -->
                    <TextView
                        android:id="@+id/btnToggleSo"
                        android:layout_height="32dp"
                        android:layout_width="wrap_content"
                        android:minWidth="68dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:background="@drawable/neon_action_cyan_bg"
                        android:text="LOAD"
                        android:textColor="#0A84FF"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:gravity="center" />

                </LinearLayout>

            </LinearLayout>

            <!-- Target Game & Account Slot Switcher Bar -->
            <TextView
                android:id="@+id/btnSwitchGameBar"
                android:layout_height="44dp"
                android:layout_width="match_parent"
                android:background="@drawable/white_card_bg"
                android:text="Target Game: BGMI • Slot 1   [SWITCH GAME / SLOT]"
                android:textColor="#0A84FF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="10dp" />

            <!-- Primary Apple Prominent System Blue Button: Start Game -->
            <TextView
                android:id="@+id/startBgmi"
                android:layout_height="52dp"
                android:layout_width="match_parent"
                android:background="@drawable/gradient_login_btn"
                android:text="Start Game"
                android:textColor="#FFFFFF"
                android:textSize="16.5sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:gravity="center"
                android:stateListAnimator="@null" />

            <!-- Hidden Legacy Controls (Removed from UI as requested) -->
            <Switch
                android:id="@+id/hiderecording"
                android:layout_height="0dp"
                android:layout_width="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnClearLogin"
                android:layout_height="0dp"
                android:layout_width="0dp"
                android:visibility="gone" />

            <!-- Minimal Apple Progress Card -->
            <LinearLayout
                android:id="@+id/progressCard"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:visibility="gone"
                android:background="@drawable/white_card_bg"
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/progressText"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Preparing..."
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_height="6dp"
                    android:layout_width="match_parent"
                    android:max="100"
                    android:indeterminate="false"
                    android:progressTint="#0A84FF"
                    android:progressBackgroundTint="#2C2C2E"
                    style="?android:attr/progressBarStyleHorizontal" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>