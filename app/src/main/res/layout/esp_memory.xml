<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Small Crosshair Section -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="10dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@drawable/btn_round"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:weightSum="2.0"
                    android:backgroundTint="@color/theme2">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.5">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/injecton"
                            android:layout_marginStart="10dp" />
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:gravity="start|center_vertical"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="5dp"
                                android:text="@string/small_crosshair"
                                android:layout_marginStart="10dp" />
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/whitegelap"
                                android:gravity="start|center_vertical"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/reduces_size_of_crosshairs"
                                android:layout_marginStart="10dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="end|center_vertical"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.5">
                        <Switch
                            android:id="@+id/issmallcross"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumb="@drawable/ic_switch_off"
                            android:track="@drawable/ic_switch_on"
                            android:layout_marginEnd="10dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Wide View Section -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="5dp">
                            <LinearLayout
                                android:background="@color/theme2"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_weight="1.0" />
                            <TextView
                                android:textStyle="bold"
                                android:textColor="@android:color/white"
                                android:layout_gravity="center"
                                android:padding="8dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/wide_view" />
                            <LinearLayout
                                android:background="@color/theme2"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_weight="1.0"
                                android:layout_marginEnd="5dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_weight="1.0"
                            android:layout_marginStart="5dp">
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/whitegelap"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/set_wide_view_range"
                                android:layout_marginStart="10dp" />
                            <TextView
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:id="@+id/rangetextwide"
                                android:layout_width="40dp"
                                android:layout_height="wrap_content"
                                android:text="@string/esp_memory_rangetextwide_text"
                                android:layout_weight="1.0"
                                android:layout_marginStart="10dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <SeekBar
                            android:id="@+id/rangewide"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:max="8"
                            android:progress="0"
                            android:layout_weight="1.0"
                            android:progressTint="@color/buttonof"
                            android:thumbTint="@color/buttonof" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            
        </LinearLayout>
    </ScrollView>
</RelativeLayout>